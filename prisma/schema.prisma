generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id       String @id @default(uuid())
  twitchId String @unique
  username String

  level       Int       @default(1)
  xp          Int       @default(0)
  coins       Int       @default(100)
  lastDailyAt DateTime?

  palSpheres   Int @default(0)
  megaSpheres  Int @default(0)
  gigaSpheres  Int @default(0)
  hyperSpheres Int @default(0)

  paldium Int @default(0)
  wood    Int @default(0)
  stone   Int @default(0)

  monsters      Monster[]
  paldexEntries PaldexEntry[]
  dailyQuests   DailyQuest[]
  expedition    Expedition?

  createdAt DateTime @default(now())
}

model PaldexEntry {
  id           String   @id @default(uuid())
  playerId     String
  species      String
  paldeck      String?
  rarity       String
  hasLucky     Boolean  @default(false)
  discoveredAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, species])
  @@index([playerId])
  @@index([paldeck])
}

model Monster {
  id      String  @id @default(uuid())
  species String
  paldeck String?
  type1   String?
  type2   String?
  level   Int
  hp      Int
  attack  Int
  defense Int
  speed   Int
  rarity  String
  shiny   Boolean @default(false)

  ownerId String?
  owner   Player? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  streamerId String?
  streamer   Streamer? @relation(fields: [streamerId], references: [id], onDelete: SetNull)

  expedition Expedition?

  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([streamerId])
  @@index([species])
}

model Expedition {
  id String @id @default(uuid())

  playerId  String @unique
  monsterId String @unique

  startedAt   DateTime @default(now())
  completesAt DateTime

  coinReward      Int
  palSphereReward Int
  paldiumReward   Int
  woodReward      Int
  stoneReward     Int

  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@index([completesAt])
}

model Streamer {
  id String @id @default(uuid())

  twitchId    String @unique
  channelName String @unique

  live      Boolean   @default(true)
  lastSpawn DateTime?

  monsters Monster[]

  createdAt DateTime @default(now())
}

model DailyQuest {
  id String @id @default(uuid())

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  questType String
  title     String

  target   Int
  progress Int @default(0)

  rewardType   String
  rewardAmount Int

  completed Boolean @default(false)
  claimed   Boolean @default(false)

  questDate DateTime

  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([questDate])
  @@index([playerId, questDate])
}
